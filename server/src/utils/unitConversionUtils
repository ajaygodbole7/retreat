// src/utils/unitConversionUtils.ts

import { AppError } from '../middleware/errorHandler';
import { HttpStatus } from '../constants/httpStatus';

// Define unit types for categorization
export enum UnitType {
    VOLUME = 'VOLUME',
    WEIGHT = 'WEIGHT',
    COUNT = 'COUNT',
    LENGTH = 'LENGTH',
    TEMPERATURE = 'TEMPERATURE',
    OTHER = 'OTHER'
}

// Define conversion factors relative to base units
// Base units: grams for weight, milliliters for volume
interface UnitConversionFactor {
    type: UnitType;
    toBase: number; // Multiply by this to convert to base unit
    fromBase: number; // Multiply by this to convert from base unit
}

