# anita4/.ebextensions/02_server_setup.config
# Commands in 'container_commands' run after the application code is staged
# on the Elastic Beanstalk instance but before the application version is deployed.
# 'leader_only: true' ensures these commands run on only one instance during deployment/scaling.
# 'cwd' specifies the Current Working Directory for the command, relative to /var/app/current/.

#option_settings:
  # This tells EB's Node.js platform that our Procfile will specify how to start the app.
#  aws:elasticbeanstalk:container:nodejs:
#    NodeCommand: "echo Application will be started via Procfile using PM2"

container_commands:
#  01_install_server_dependencies:
#   command: "npm install" # Installs only production dependencies
#   cwd: "/var/app/staging/server"    # Executes 'npm install' inside the 'server' directory
#    leader_only: true
#    ignoreErrors: false # If dependencies fail to install, the deployment should fail.

  01_install_native_dependencies:
    command: "npm install bcrypt @prisma/client --no-save"
    cwd: "/var/app/staging/server"
    leader_only: true
    
  02_prisma_generate:
    command: "npx prisma generate"
    cwd: "/var/app/staging/server"
    leader_only: true

# 03_build_server_app:
#    # Checks if a 'build' script exists in server/package.json and runs it.
#    command: "if grep -q '\"build\":' package.json; then npm run build; else echo 'Server: No build script found, skipping build.'; fi"
#    cwd: "/var/app/staging/server"    # Executes in the 'server' directory
#    leader_only: true
#    ignoreErrors: false # If the build script fails, deployment should fail.

  # Optional: Add Prisma Migrate Deploy here if you want automated migrations.
  # Ensure this runs *after* the database is ready and accessible.
  # Be cautious with automated migrations in production without proper review/backup strategy.
  # 04_prisma_migrate_deploy:
  #   command: "npx prisma migrate deploy"
  #   cwd: "/var/app/current/server"
  #   leader_only: true
  #   ignoreErrors: false # Deployment should fail if migrations fail